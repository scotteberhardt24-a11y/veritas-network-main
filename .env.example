# ── Deployer wallet (keep secret, never commit) ──
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── Polygon RPC ──
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_key

# ── PolygonScan API (for contract verification) ──
POLYGONSCAN_API_KEY=your_polygonscan_key

# ── After deployment, fill these in ──
CONTRACT_ADDRESS=0x...deployed_contract_address
BACKEND_WALLET_ADDRESS=0x...backend_hot_wallet

# ── Metadata ──
METADATA_BASE_URI=https://veritasbackend.up.railway.app/api/passport/metadata/
